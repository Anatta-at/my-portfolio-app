# Clerk Keys (ต้องใช้เพื่อรันระบบ Login)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# Database URL (ใช้อันนี้เมื่อรันบน Cloud เช่น Render, Railway)
DATABASE_URL="your_database_url_here"

# ✅ เพิ่มใหม่: Database credentials แยกส่วน (ใช้เมื่อรัน local หรือ Docker)
# ก่อน: ค่าเหล่านี้ถูก hardcode ใน source code → ตอนนี้อ่านจาก .env แทน
DB_NAME=intelliport_db
DB_USER=admin
DB_PASSWORD=your_db_password_here
DB_PORT=5432
DATABASE_HOST=localhost

# ✅ เพิ่มใหม่: กำหนด CORS origins ที่อนุญาต (คั่นด้วย comma)
# ก่อน: CORS เปิด allow_origins=["*"] ให้ทุก domain
# หลัง: ระบุ domain ที่อนุญาตชัดเจน
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Backend API URL (ใช้ใน Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
